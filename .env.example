# Environment Configuration Template
# Copy to .env and customize as needed

# Proxy Configuration
PROXY_PORT=8080
INSPECTION_API_PORT=8081

# Cryptographic Keys
KEY_DIR=./keys

# Classification Thresholds
TIER2_CONFIDENCE_THRESHOLD=0.75
SESSION_TIMEOUT_MINUTES=30

# PII Detection
PII_SCORE_THRESHOLD=0.6

# Token Estimation
# Options: "heuristic" or "tiktoken"
TOKEN_ESTIMATE_METHOD=heuristic

# Logging
LOG_LEVEL=INFO

# Jailbreak Patterns File
JAILBREAK_PATTERNS_PATH=./config/jailbreak_patterns.txt
